{
  "name": "xe-cung-aha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:staging": "cp .env.staging .env.local && next build",
    "build:uat": "cp .env.uat .env.local && next build",
    "build:production": "cp .env.production .env.local && next build",
    "deploy:staging": "npm run build:staging && firebase deploy --only hosting:staging",
    "deploy:uat": "npm run build:uat && firebase deploy --only hosting:uat",
    "deploy:production": "npm run build:production && firebase deploy --only hosting:production",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "html2canvas": "^1.4.1",
    "next": "16.0.1",
    "phaser": "^3.90.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "baseline-browser-mapping": "^2.9.5",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
